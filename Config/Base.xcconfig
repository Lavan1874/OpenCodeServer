// Shared settings for the native macOS application and XCTest bundle.
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17
SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = YES

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO

ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// Single source of truth for CFBundleVersion. Bump here for every acceptance
// candidate; target-level copies invite Debug/Release version skew.
CURRENT_PROJECT_VERSION = 86
